{
  "name": "webcam-vr-fps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:human": "playwright test e2e/human-camera.spec.ts --project=human-camera",
    "verify": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.0.10",
    "@types/three": "0.184.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
