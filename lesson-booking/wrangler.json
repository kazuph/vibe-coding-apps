{
  "name": "lesson-booking",
  "main": "src/worker.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "rules": [],
  "assets": {
    "directory": "./static"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lesson-booking-db",
      "database_id": "YOUR_DATABASE_ID_HERE"
    }
  ]
}
